const char* emotionName(RobotEmotion e) {
  switch (e) {
    case EMO_HAPPY: return "happy";
    case EMO_SAD: return "sad";
    case EMO_ANGRY: return "angry";
    case EMO_CURIOUS: return "curious";
    case EMO_SURPRISED: return "surprised";
    default: return "neutral";
  }
}

const char* stateName(RobotState s) {
  switch (s) {
    case STATE_IDLE: return "idle";
    case STATE_LISTENING: return "listening";
    case STATE_SENDING: return "sending";
    case STATE_EXECUTING: return "executing";
    case STATE_ERROR: return "error";
    default: return "unknown";
  }
}

void webUIInit() {
  // ── Dashboard ───────────────────────────────────────────────
  server.on("/", HTTP_GET, []() {
    server.send(200, "text/html", buildDashboardHTML());
  });

  // ── Status JSON (polled by dashboard every 1s) ──────────────
  server.on("/status", HTTP_GET, []() {
    JsonDocument doc;
    doc["state"] = stateName(robotState);
    doc["emotion"] = emotionName(currentIntent.emotion);
    doc["command"] = commandName(currentIntent.command);
    doc["transcript"] = currentIntent.transcript;
    doc["confidence"] = currentIntent.confidence;
    doc["python_connected"] = pythonConnected;
    String out;
    serializeJson(doc, out);
    server.send(200, "application/json", out);
  });

  // ── Manual listen trigger ────────────────────────────────────
  server.on("/trigger", HTTP_POST, []() {
    if (robotState == STATE_IDLE) {
      manualTrigger = true;
      server.send(200, "text/plain", "Trigger set");
      Serial.println("[M7] Manual trigger received");
    } else {
      server.send(409, "text/plain", "Busy");
    }
  });

  // ── Manual servo override (for debugging) ───────────────────
  server.on("/servo", HTTP_GET, []() {
    if (server.hasArg("id") && server.hasArg("pos")) {
      int id = server.arg("id").toInt();
      int pos = constrain(server.arg("pos").toInt(), 0, 180);
      setServoAngle(id, pos);
      server.send(200, "text/plain", "OK");
    } else {
      server.send(400, "text/plain", "Missing id/pos");
    }
  });

  // ── Manual motor override ───────────────────────────────────
  server.on("/motor", HTTP_GET, []() {
    if (server.hasArg("dir")) {
      String d = server.arg("dir");
      if (d == "forward") motorForward();
      else if (d == "backward") motorBackward();
      else if (d == "left") motorLeft();
      else if (d == "right") motorRight();
      else motorStop();
      server.send(200, "text/plain", "OK");
    } else {
      server.send(400, "text/plain", "Missing dir");
    }
  });

  // ── Expression test ─────────────────────────────────────────
  server.on("/expr", HTTP_GET, []() {
    if (server.hasArg("e")) {
      RobotEmotion e = stringToEmotion(server.arg("e").c_str());
      expressionDraw(e);
      server.send(200, "text/plain", "OK");
    } else {
      server.send(400, "text/plain", "Missing e");
    }
  });

  server.begin();
  Serial.println("[M7] Web server started");
}

