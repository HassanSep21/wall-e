void micInit() {
  i2s_config_t cfg = {
    .mode = (i2s_mode_t)(I2S_MODE_MASTER | I2S_MODE_RX),
    .sample_rate = SAMPLE_RATE,
    .bits_per_sample = I2S_BITS_PER_SAMPLE_32BIT,  // INMP441 outputs 32-bit
    .channel_format = I2S_CHANNEL_FMT_ONLY_LEFT,
    .communication_format = I2S_COMM_FORMAT_STAND_I2S,
    .intr_alloc_flags = 0,
    .dma_buf_count = 8,
    .dma_buf_len = 256,
    .use_apll = false,
    .tx_desc_auto_clear = false,
    .fixed_mclk = 0,
  };
  i2s_pin_config_t pins = {
    .bck_io_num = MIC_SCK,
    .ws_io_num = MIC_WS,
    .data_out_num = I2S_PIN_NO_CHANGE,
    .data_in_num = MIC_DIN,
  };
  i2s_driver_install(I2S_NUM_1, &cfg, 0, NULL);
  i2s_set_pin(I2S_NUM_1, &pins);
  i2s_zero_dma_buffer(I2S_NUM_1);
}

// Compute RMS of a 32-bit sample buffer (INMP441 raw)
uint32_t computeRMS(int32_t* samples, int count) {
  if (count <= 0) return 0;
  int64_t sumSq = 0;
  for (int i = 0; i < count; i++) {
    int32_t s = samples[i] >> 14;  // scale down from 32-bit
    sumSq += (int64_t)s * s;
  }
  return (uint32_t)sqrt((double)(sumSq / count));
}

// Core 0 FreeRTOS task — runs forever, handles VAD + recording
void audioTask(void* param) {
  int32_t chunk[AUDIO_CHUNK_SAMPLES];
  int16_t convertBuf[AUDIO_CHUNK_SAMPLES];
  size_t bytesRead = 0;
  bool recording = false;
  uint32_t recStart = 0;

  for (;;) {
    // Read one chunk from mic
    esp_err_t err = i2s_read(
      I2S_NUM_1, chunk, sizeof(chunk), &bytesRead,
      pdMS_TO_TICKS(100));

    if (err != ESP_OK || bytesRead == 0) {
      vTaskDelay(pdMS_TO_TICKS(10));
      continue;
    }

    int samplesRead = bytesRead / 4;  // 4 bytes per 32-bit sample
    uint32_t rms = computeRMS(chunk, samplesRead);

    uint32_t now = millis();

    // ── VAD logic ────────────────────────────────────────────────
    bool vadFired = (rms > VAD_THRESHOLD) && (now - lastVadTrigger > VAD_DEBOUNCE_MS);

    bool shouldRecord = vadFired || manualTrigger;

    // Start recording if triggered and not already recording
    if (shouldRecord && !recording && !audioReady) {
      // Only start if main loop is in IDLE state
      if (robotState == STATE_IDLE) {
        recording = true;
        recStart = now;
        audioBytesRecorded = 0;
        lastVadTrigger = now;
        manualTrigger = false;
        Serial.printf("[M1] Recording started (RMS=%u, manual=%s)\n",
                      rms, shouldRecord ? "yes" : "no");
      }
    }

    // If recording, downsample 32-bit → 16-bit and fill buffer
    if (recording) {
      for (int i = 0; i < samplesRead; i++) {
        convertBuf[i] = (int16_t)(chunk[i] >> 16);
      }
      uint32_t bytesToWrite = samplesRead * 2;
      uint32_t remaining = AUDIO_BUFFER_BYTES - audioBytesRecorded;

      if (bytesToWrite > remaining) bytesToWrite = remaining;
      memcpy(audioBuffer + audioBytesRecorded, convertBuf, bytesToWrite);
      audioBytesRecorded += bytesToWrite;

      // Stop recording when duration elapsed or buffer full
      bool durationElapsed = (now - recStart) >= RECORD_DURATION_MS;
      bool bufferFull = audioBytesRecorded >= AUDIO_BUFFER_BYTES;

      if (durationElapsed || bufferFull) {
        recording = false;
        audioReady = true;
        Serial.printf("[M1] Recording done: %u bytes (%.2fs)\n",
                      audioBytesRecorded,
                      audioBytesRecorded / (float)(SAMPLE_RATE * 2));
      }
    }

    vTaskDelay(1);  // yield to other tasks
  }
}

