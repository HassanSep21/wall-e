// Motor helpers
void motorStop() {
  digitalWrite(IN1, LOW);
  digitalWrite(IN2, LOW);
  digitalWrite(IN3, LOW);
  digitalWrite(IN4, LOW);
}
void motorForward() {
  digitalWrite(IN1, HIGH);
  digitalWrite(IN2, LOW);
  digitalWrite(IN3, HIGH);
  digitalWrite(IN4, LOW);
}
void motorBackward() {
  digitalWrite(IN1, LOW);
  digitalWrite(IN2, HIGH);
  digitalWrite(IN3, LOW);
  digitalWrite(IN4, HIGH);
}
void motorLeft() {
  digitalWrite(IN1, LOW);
  digitalWrite(IN2, HIGH);
  digitalWrite(IN3, HIGH);
  digitalWrite(IN4, LOW);
}
void motorRight() {
  digitalWrite(IN1, HIGH);
  digitalWrite(IN2, LOW);
  digitalWrite(IN3, LOW);
  digitalWrite(IN4, HIGH);
}

void setServoAngle(int id, int angle) {
  angle = constrain(angle, 0, 180);
  if (id == 1) servo1.write(angle);
  else if (id == 2) servo2.write(angle);
  else if (id == 3) servo3.write(angle);
}

// Motor direction codes for use in MotionStep.value
#define MOT_STOP 0
#define MOT_FORWARD 1
#define MOT_BACKWARD 2
#define MOT_LEFT 3
#define MOT_RIGHT 4

// Motor step: servoId == 0 means it's a motor command
void applyMotionStep(const MotionStep& step) {
  if (step.servoId == 0) {
    switch (step.value) {
      case MOT_STOP: motorStop(); break;
      case MOT_FORWARD: motorForward(); break;
      case MOT_BACKWARD: motorBackward(); break;
      case MOT_LEFT: motorLeft(); break;
      case MOT_RIGHT: motorRight(); break;
    }
  } else {
    setServoAngle(step.servoId, step.value);
  }
}

