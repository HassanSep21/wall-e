RobotCommand stringToCommand(const char* s) {
  if (strcmp(s, "dance") == 0) return CMD_DANCE;
  if (strcmp(s, "wave") == 0) return CMD_WAVE;
  if (strcmp(s, "stop") == 0) return CMD_STOP;
  if (strcmp(s, "spin") == 0) return CMD_SPIN;
  if (strcmp(s, "look") == 0) return CMD_LOOK;
  if (strcmp(s, "sleep") == 0) return CMD_SLEEP;
	if (strcmp(s, "forward")  == 0) return CMD_FORWARD;
	if (strcmp(s, "backward") == 0) return CMD_BACKWARD;
	if (strcmp(s, "left")     == 0) return CMD_LEFT;
	if (strcmp(s, "right")    == 0) return CMD_RIGHT;
  return CMD_IDLE;
}

RobotEmotion stringToEmotion(const char* s) {
  if (strcmp(s, "happy") == 0) return EMO_HAPPY;
  if (strcmp(s, "sad") == 0) return EMO_SAD;
  if (strcmp(s, "angry") == 0) return EMO_ANGRY;
  if (strcmp(s, "curious") == 0) return EMO_CURIOUS;
  if (strcmp(s, "surprised") == 0) return EMO_SURPRISED;
  return EMO_NEUTRAL;
}

bool parseResponse(const String& json, RobotIntent& intent) {
  JsonDocument doc;
  DeserializationError err = deserializeJson(doc, json);

  if (err) {
    Serial.printf("[M3] JSON parse error: %s\n", err.c_str());
    return false;
  }

  // Check for server-side error flag
  if (!doc["error"].isNull() && doc["error"].as<String>() != "null") {
    Serial.printf("[M3] Server error: %s\n", doc["error"].as<String>().c_str());
    return false;
  }

  const char* cmd = doc["command"] | "idle";
  const char* emo = doc["emotion"] | "neutral";
  float conf = doc["confidence"] | 0.0f;
  float emoConf = doc["emotion_confidence"] | 0.0f;
  bool matched = doc["command_matched"] | false;
  const char* tr = doc["transcript"] | "";

  intent.command = stringToCommand(cmd);
  intent.emotion = stringToEmotion(emo);
  intent.confidence = conf;
  intent.emotionConfidence = emoConf;
  intent.commandMatched = matched;
  strncpy(intent.transcript, tr, sizeof(intent.transcript) - 1);
  intent.transcript[sizeof(intent.transcript) - 1] = '\0';

  Serial.printf("[M3] Intent: cmd=%s emo=%s conf=%.2f tr=\"%s\"\n",
                cmd, emo, conf, tr);
  return true;
}

