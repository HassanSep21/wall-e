// Current sequence pointers (set by M4)
static const MotionStep* activeSeq = nullptr;
static int activeSeqSteps = 0;

void motionStartSequence(RobotCommand cmd) {
  sequenceStartMs = millis();
  sequenceStep = 0;

  switch (cmd) {
    case CMD_DANCE:
      activeSeq = DANCE_SEQ;
      activeSeqSteps = DANCE_STEPS;
      sequenceDurationMs = DANCE_DUR;
      break;
    case CMD_WAVE:
      activeSeq = WAVE_SEQ;
      activeSeqSteps = WAVE_STEPS;
      sequenceDurationMs = WAVE_DUR;
      break;
    case CMD_STOP:
      activeSeq = STOP_SEQ;
      activeSeqSteps = STOP_STEPS;
      sequenceDurationMs = STOP_DUR;
      break;
    case CMD_SPIN:
      activeSeq = SPIN_SEQ;
      activeSeqSteps = SPIN_STEPS;
      sequenceDurationMs = SPIN_DUR;
      break;
    case CMD_LOOK:
      activeSeq = LOOK_SEQ;
      activeSeqSteps = LOOK_STEPS;
      sequenceDurationMs = LOOK_DUR;
      break;
    case CMD_SLEEP:
      activeSeq = SLEEP_SEQ;
      activeSeqSteps = SLEEP_STEPS;
      sequenceDurationMs = SLEEP_DUR;
      break;
		case CMD_FORWARD:
			activeSeq          = FORWARD_SEQ;
			activeSeqSteps     = FORWARD_STEPS;
			sequenceDurationMs = FORWARD_DUR;
			break;
		case CMD_BACKWARD:
			activeSeq          = BACKWARD_SEQ;
			activeSeqSteps     = BACKWARD_STEPS;
			sequenceDurationMs = BACKWARD_DUR;
			break;
		case CMD_LEFT:
			activeSeq          = LEFT_SEQ;
			activeSeqSteps     = LEFT_STEPS;
			sequenceDurationMs = LEFT_DUR;
			break;
		case CMD_RIGHT:
			activeSeq          = RIGHT_SEQ;
			activeSeqSteps     = RIGHT_STEPS;
			sequenceDurationMs = RIGHT_DUR;
			break;
    default:
      activeSeq = nullptr;
      activeSeqSteps = 0;
      sequenceDurationMs = 0;
      break;
  }
  Serial.printf("[M5] Sequence started: cmd=%d steps=%d dur=%ums\n",
                cmd, activeSeqSteps, sequenceDurationMs);
}

// Call every loop() iteration — non-blocking sequencer tick
void motionUpdate() {
  if (activeSeq == nullptr || sequenceStep >= activeSeqSteps) return;

  uint32_t elapsed = millis() - sequenceStartMs;

  while (sequenceStep < activeSeqSteps) {
    if (elapsed >= (uint32_t)activeSeq[sequenceStep].offsetMs) {
      applyMotionStep(activeSeq[sequenceStep]);
      sequenceStep++;
    } else {
      break;
    }
  }
}

bool motionSequenceDone() {
  if (activeSeq == nullptr) return true;
  return (millis() - sequenceStartMs) >= sequenceDurationMs;
}

// ============================================================
// ============================================================
//  M6 — EXPRESSION ENGINE (TFT)
// ============================================================
// ============================================================

// TFT layout: 160×128 (rotated)
// Left eye center:  (50, 64)
// Right eye center: (110, 64)
// Eye radius base:  22

#define EYE_L_X 50
#define EYE_L_Y 64
#define EYE_R_X 110
#define EYE_R_Y 64
#define EYE_R 22

// Colours
#define COL_BG ST77XX_BLACK
#define COL_EYE_WHITE ST77XX_WHITE
#define COL_HAPPY 0xFFE0      // yellow
#define COL_SAD 0x001F        // blue
#define COL_ANGRY 0xF800      // red
#define COL_CURIOUS 0x07FF    // cyan
#define COL_SURPRISED 0xFFFF  // white (wide)
#define COL_NEUTRAL 0xFFFF

void tftClearEyeArea() {
  tft.fillRect(0, 30, 160, 96, COL_BG);
}

// Draw a single eye: (cx,cy) center, colour, shape modifier
void drawEye(int cx, int cy, uint16_t colour, int shape) {
  /*
   * shape:
   *   0 = neutral oval
   *   1 = happy (clipped bottom = upward curve)
   *   2 = sad   (clipped top = drooped)
   *   3 = angry (inner-top corner cut = angled)
   *   4 = curious (slightly wider)
   *   5 = surprised (large circle)
   */
  int r = EYE_R;

  switch (shape) {
    case 0:  // neutral
      tft.fillCircle(cx, cy, r, colour);
      tft.fillRect(cx - r, cy + 8, r * 2 + 1, r, COL_BG);  // clip lower third
      break;

    case 1:  // happy — fill circle then mask bottom → looks like ^ eyes
      tft.fillCircle(cx, cy, r, colour);
      tft.fillRect(cx - r - 2, cy + 4, r * 2 + 4, r + 4, COL_BG);
      break;

    case 2:  // sad — clip top portion
      tft.fillCircle(cx, cy + 6, r, colour);
      tft.fillRect(cx - r - 2, cy - r - 2, r * 2 + 4, r - 2, COL_BG);
      break;

    case 3:  // angry — draw circle then mask inner top triangle
      tft.fillCircle(cx, cy, r, colour);
      tft.fillRect(cx - r, cy - r, r * 2, 10, COL_BG);
      // slanted mask (inner side)
      for (int i = 0; i < 14; i++) {
        int side = (cx == EYE_L_X) ? 1 : -1;  // mirror for each eye
        tft.drawFastHLine(cx + side * (r - i), cy - r + i, i, COL_BG);
      }
      break;

    case 4:  // curious — one eye wider
      tft.fillCircle(cx, cy, r + 4, colour);
      tft.fillRect(cx - r - 6, cy + 8, r * 2 + 12, r + 4, COL_BG);
      break;

    case 5:  // surprised — full large circles
      tft.fillCircle(cx, cy, r + 5, colour);
      break;
  }

  // Pupil (small dark circle in center)
  if (shape != 5) {
    tft.fillCircle(cx, cy - 2, 6, COL_BG);
  } else {
    tft.fillCircle(cx, cy, 7, COL_BG);
  }
}

void expressionDraw(RobotEmotion emo) {
  switch (emo) {
    case EMO_HAPPY:
      tft.drawRGBBitmap(0, 30, img_happy, 160, 96);
      break;
    case EMO_SAD:
      tft.drawRGBBitmap(0, 30, img_sad, 160, 96);
      break;
    case EMO_ANGRY:
      tft.drawRGBBitmap(0, 30, img_angry, 160, 96);
      break;
    case EMO_CURIOUS:
      tft.drawRGBBitmap(0, 30, img_curious, 160, 96);
      break;
    case EMO_SURPRISED:
      tft.drawRGBBitmap(0, 30, img_surprised, 160, 96);
      break;
    case EMO_NEUTRAL:
    default:
      tft.drawRGBBitmap(0, 30, img_neutral, 160, 96);
      break;
  }

  Serial.printf("[M6] Expression drawn: emotion=%d\n", (int)emo);
}

void expressionBlink() {
  // Cover eyes with black bar — quick blink
  tft.fillRect(0, EYE_L_Y - 6, 160, 12, COL_BG);
}

// Idle animation: slow ±10° head drift and periodic blink
static uint32_t idleDriftMs = 0;
static int idleDriftDir = 1;
static int idleHeadPos = 90;

void idleUpdate() {
  uint32_t now = millis();

  // Blink logic
  if (!eyesClosed && now >= nextBlinkMs) {
    eyesClosed = true;
    blinkStartMs = now;
    expressionBlink();
    nextBlinkMs = now + random(3000, 6000);
  }
  if (eyesClosed && (now - blinkStartMs) >= BLINK_DURATION_MS) {
    eyesClosed = false;
    expressionDraw(EMO_NEUTRAL);
  }

  // Slow head drift
  if (now - idleDriftMs >= 800) {
    idleDriftMs = now;
    idleHeadPos += idleDriftDir * 5;
    if (idleHeadPos >= 100) {
      idleHeadPos = 100;
      idleDriftDir = -1;
    }
    if (idleHeadPos <= 80) {
      idleHeadPos = 80;
      idleDriftDir = 1;
    }
    servo1.write(idleHeadPos);
  }
}

// ============================================================
// ============================================================
//  M4 — ACTION DISPATCHER (STATE MACHINE)
// ============================================================
// ============================================================

void enterState(RobotState newState) {
  Serial.printf("[M4] State: %d → %d\n", (int)robotState, (int)newState);
  robotState = newState;
  stateEnteredAt = millis();
}

void dispatchIntent(const RobotIntent& intent) {
  // Draw expression immediately
  expressionDraw(intent.emotion);

  // Start motion sequence
  motionStartSequence(intent.command);

  // Update TFT status line
  tft.fillRect(0, 0, 160, 28, COL_BG);
  tft.setCursor(2, 2);
  tft.setTextColor(ST77XX_GREEN);
  tft.setTextSize(1);
  tft.printf("%.20s", intent.transcript[0] ? intent.transcript : "...");
  tft.setCursor(2, 14);
  tft.setTextColor(ST77XX_CYAN);
  tft.printf("cmd:%-6s", commandName(intent.command));

  enterState(STATE_EXECUTING);
}

const char* commandName(RobotCommand c) {
  switch (c) {
    case CMD_DANCE: return "dance";
    case CMD_WAVE: return "wave";
    case CMD_STOP: return "stop";
    case CMD_SPIN: return "spin";
    case CMD_LOOK: return "look";
    case CMD_SLEEP: return "sleep";
    default: return "idle";
  }
}

// Called every loop() — the core state machine tick
void stateMachineUpdate() {
  uint32_t now = millis();

  switch (robotState) {

    // ── IDLE ────────────────────────────────────────────────────
    case STATE_IDLE:
      idleUpdate();

      if (audioReady) {
        audioReady = false;
        enterState(STATE_SENDING);
      }
      break;

    // ── SENDING ─────────────────────────────────────────────────
    case STATE_SENDING:
      {
        // Show "thinking" face on TFT
        tft.fillRect(0, 0, 160, 16, COL_BG);
        tft.setCursor(2, 2);
        tft.setTextColor(ST77XX_YELLOW);
        tft.setTextSize(1);
        tft.print("Thinking...");
        expressionDraw(EMO_CURIOUS);

        String jsonResp = sendAudioToServer(audioBuffer, audioBytesRecorded);

        if (jsonResp.isEmpty()) {
          Serial.println("[M4] No response from server → going to IDLE");
          expressionDraw(EMO_NEUTRAL);
          enterState(STATE_IDLE);
          break;
        }

        RobotIntent intent = {};
        if (parseResponse(jsonResp, intent)) {
          currentIntent = intent;
          dispatchIntent(currentIntent);
        } else {
          expressionDraw(EMO_NEUTRAL);
          enterState(STATE_IDLE);
        }
        break;
      }

    // ── EXECUTING ───────────────────────────────────────────────
    case STATE_EXECUTING:
      motionUpdate();

      if (motionSequenceDone()) {
        Serial.println("[M4] Sequence done → IDLE");
        motorStop();
        // Hold the emotion face for 2 extra seconds before returning to neutral
        delay(2000);
        if (currentIntent.command != CMD_SLEEP) {
          expressionDraw(EMO_NEUTRAL);
        }
        nextBlinkMs = millis() + 2000;
        enterState(STATE_IDLE);
      }
      break;

    // ── ERROR ───────────────────────────────────────────────────
    case STATE_ERROR:
      // Retry ping every 5s
      if (now - stateEnteredAt >= 5000) {
        if (pingPythonServer()) {
          pythonConnected = true;
          expressionDraw(EMO_NEUTRAL);
          enterState(STATE_IDLE);
        } else {
          stateEnteredAt = now;  // reset timer
        }
      }
      break;

    default:
      enterState(STATE_IDLE);
      break;
  }
}

