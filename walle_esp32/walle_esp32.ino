// ============================================================
//  SETUP + LOOP
// ============================================================
// ============================================================

void setup() {
  Serial.begin(115200);
  delay(800);
  Serial.println("\n[BOOT] WALL-E ESP32 starting...");

  // ── Motor pins ────────────────────────────────────────────
  pinMode(IN1, OUTPUT);
  pinMode(IN2, OUTPUT);
  pinMode(IN3, OUTPUT);
  pinMode(IN4, OUTPUT);
  motorStop();

  // ── TFT backlight ─────────────────────────────────────────
  pinMode(TFT_BL, OUTPUT);
  digitalWrite(TFT_BL, HIGH);

  // ── Servos ────────────────────────────────────────────────
  ESP32PWM::allocateTimer(0);
  ESP32PWM::allocateTimer(1);
  ESP32PWM::allocateTimer(2);
  ESP32PWM::allocateTimer(3);

  servo1.setPeriodHertz(50);
  servo1.attach(SERVO1_PIN, 500, 2400);
  servo2.setPeriodHertz(50);
  servo2.attach(SERVO2_PIN, 500, 2400);
  servo3.setPeriodHertz(50);
  servo3.attach(SERVO3_PIN, 500, 2400);
  servo1.write(90);
  servo2.write(90);
  servo3.write(90);

  // ── TFT ───────────────────────────────────────────────────
  mySPI.begin(TFT_SCLK, -1, TFT_MOSI, TFT_CS);
  tft.initR(INITR_BLACKTAB);
  tft.setRotation(1);
  tft.fillScreen(COL_BG);
  tft.setCursor(10, 10);
  tft.setTextColor(ST77XX_YELLOW);
  tft.setTextSize(2);
  tft.println("WALL-E");
  tft.setTextSize(1);
  tft.setTextColor(ST77XX_WHITE);
  tft.println("Booting...");

  // ── Microphone ────────────────────────────────────────────
  micInit();

  // ── WiFi AP ───────────────────────────────────────────────
  WiFi.mode(WIFI_AP);
  WiFi.softAP(AP_SSID, AP_PASS);
  IPAddress apIP = WiFi.softAPIP();
  Serial.print("[BOOT] AP IP: ");
  Serial.println(apIP);

  tft.fillScreen(COL_BG);
  tft.setCursor(4, 4);
  tft.setTextColor(ST77XX_GREEN);
  tft.setTextSize(1);
  tft.println("WiFi AP: " + String(AP_SSID));
  tft.println("IP: " + apIP.toString());
  tft.setTextColor(ST77XX_YELLOW);
  tft.println("Pinging Python...");

  // ── Ping Python server ────────────────────────────────────
  delay(500);  // brief wait — one-time at boot only
  pythonConnected = pingPythonServer();

  tft.fillRect(0, 36, 160, 12, COL_BG);
  tft.setCursor(4, 36);
  if (pythonConnected) {
    tft.setTextColor(ST77XX_GREEN);
    tft.println("Python: OK");
  } else {
    tft.setTextColor(ST77XX_RED);
    tft.println("Python: offline");
  }
  delay(1200);  // show status briefly — one-time at boot only

  // ── Web UI ────────────────────────────────────────────────
  webUIInit();

  // ── Initial expression ────────────────────────────────────
  tft.fillScreen(COL_BG);
  expressionDraw(EMO_NEUTRAL);
  nextBlinkMs = millis() + 3000;

  // ── Audio capture task on Core 0 ─────────────────────────
  xTaskCreatePinnedToCore(
    audioTask,         // function
    "AudioTask",       // name
    8192,              // stack size
    NULL,              // parameter
    2,                 // priority (higher = more urgent)
    &audioTaskHandle,  // handle
    0                  // Core 0
  );

  Serial.println("[BOOT] Ready. Speak near the mic or press Listen on web UI.");
  Serial.printf("[BOOT] Python server: %s:%d\n", PYTHON_SERVER_IP, PYTHON_SERVER_PORT);
}

void loop() {
  server.handleClient();  // M7 — serve web UI requests
  stateMachineUpdate();   // M4 — main state machine tick
  // M5 (motionUpdate) is called inside stateMachineUpdate during EXECUTING state
}
