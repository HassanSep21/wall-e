String buildServerURL(const char* endpoint) {
  return String("http://") + PYTHON_SERVER_IP + ":" + PYTHON_SERVER_PORT + endpoint;
}

bool pingPythonServer() {
  HTTPClient http;
  http.setTimeout(PING_TIMEOUT_MS);
  http.begin(buildServerURL("/ping"));
  int code = http.GET();
  http.end();
  bool ok = (code == 200);
  Serial.printf("[M2] Ping %s (HTTP %d)\n", ok ? "OK" : "FAILED", code);
  return ok;
}

// Send audio buffer to Python, return raw JSON string
// Returns empty string on failure
String sendAudioToServer(uint8_t* buf, uint32_t len) {
  if (len == 0) {
    Serial.println("[M2] Audio buffer empty, skipping send");
    return "";
  }

  HTTPClient http;
  http.setTimeout(HTTP_TIMEOUT_MS);
  http.begin(buildServerURL("/process"));
  http.addHeader("Content-Type", "application/octet-stream");
  http.addHeader("X-Sample-Rate", String(SAMPLE_RATE));
  http.addHeader("X-Bytes", String(len));

  Serial.printf("[M2] POST %u bytes to Python server...\n", len);
  uint32_t t0 = millis();
  int code = http.POST(buf, len);
  uint32_t dt = millis() - t0;

  if (code != 200) {
    Serial.printf("[M2] POST failed: HTTP %d (%ums)\n", code, dt);
    http.end();
    return "";
  }

  String body = http.getString();
  http.end();
  Serial.printf("[M2] Response received (%ums): %s\n", dt, body.c_str());
  return body;
}

